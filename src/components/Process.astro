---
const steps = [
  {
    number: '01',
    title: 'Descubrimiento',
    description:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Analizamos tu operación, tus objetivos y tus canales para definir la hoja de ruta del proyecto.',
  },
  {
    number: '02',
    title: 'Diseño y estrategia',
    description:
      'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Prototipamos la solución y validamos cada flujo contigo antes de escribir una línea de código.',
  },
  {
    number: '03',
    title: 'Desarrollo e integración',
    description:
      'Ut enim ad minim veniam, quis nostrud exercitation ullamco. Construimos, integramos con tus sistemas y automatizamos los procesos clave de tu negocio.',
  },
  {
    number: '04',
    title: 'Lanzamiento y escala',
    description:
      'Duis aute irure dolor in reprehenderit in voluptate velit. Desplegamos, medimos resultados y evolucionamos la plataforma con mejoras continuas.',
  },
] as const;
---

<section id="proceso" class="relative py-28" aria-label="Proceso de trabajo">
  <div class="mx-auto max-w-7xl px-6">
    <div class="max-w-3xl" data-reveal>
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-accent-400">Cómo trabajamos</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Un proceso claro, <span class="bg-gradient-to-r from-accent-200 to-accent-500 bg-clip-text text-transparent">resultados medibles</span>
      </h2>
      <p class="mt-4 leading-relaxed text-slate-400">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt
        ut labore et dolore magna aliqua.
      </p>
    </div>

    <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <li data-reveal data-tilt class="relative rounded-3xl border border-white/10 bg-surface/60 p-7 backdrop-blur">
          <span class="text-4xl font-extrabold text-accent-500/25">{step.number}</span>
          <h3 class="mt-4 text-lg font-bold text-white">{step.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-400">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

---
---

<!-- Barra de progreso de scroll -->
<div id="scroll-progress" class="fixed left-0 top-0 z-[60] h-0.5 w-full origin-left scale-x-0 bg-accent-500" aria-hidden="true"></div>

<header id="navbar" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5" aria-label="Navegación principal">
    <a href="/" class="flex items-center gap-3" aria-label="Kaido Group - Inicio">
      <!-- Logo vectorial K -->
      <svg width="36" height="36" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="48" height="48" rx="12" fill="url(#logoGrad)" />
        <path d="M16 13v22M16 24l12-11M18.5 26.5L32 35" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: rgb(var(--midnight))" />
        <defs>
          <linearGradient id="logoGrad" x1="0" y1="0" x2="48" y2="48" gradientUnits="userSpaceOnUse">
            <stop style="stop-color: rgb(var(--accent-200))" />
            <stop offset="0.5" style="stop-color: rgb(var(--accent-500))" />
            <stop offset="1" style="stop-color: rgb(var(--accent-700))" />
          </linearGradient>
        </defs>
      </svg>
      <span class="text-lg font-bold tracking-tight text-white">Kaido<span class="text-linco">Group</span></span>
    </a>

    <ul class="hidden items-center gap-8 text-sm font-medium text-slate-300 md:flex">
      <li><a href="#servicios" class="transition-colors hover:text-white">Servicios</a></li>
      <li><a href="#productos" class="transition-colors hover:text-white">Soluciones</a></li>
      <li><a href="#proceso" class="transition-colors hover:text-white">Proceso</a></li>
      <li><a href="#faq" class="transition-colors hover:text-white">FAQ</a></li>
      <li><a href="#contacto" class="transition-colors hover:text-white">Contacto</a></li>
    </ul>

    <a
      href="#contacto"
      data-magnetic
      class="hidden rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white transition-all hover:scale-105 hover:bg-accent-500 md:inline-block"
    >
      Agendar demo
    </a>
  </nav>
</header>

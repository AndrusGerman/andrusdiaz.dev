---
interface Experience { period: string; company: string; location: string; role: string; summary: string; details: string[]; accent: string }
interface Project { id: string; eyebrow: string; title: string; description: string; stack: string; status: string; accent: string }
interface Props { experience: Experience[]; projects: Project[]; stackGroups: string[][] }
const { experience, projects, stackGroups } = Astro.props;
const email = 'contacto@andrusdiaz.dev';
const destinations: Record<string, { href: string; label: string }> = {
  'Kaido': { href: 'https://kaidogroup.tech', label: 'Explorar Kaido' },
  'linko.store': { href: 'https://linko.store', label: 'Visitar linko.store' },
  'Pabilo': { href: 'https://pabilo.app', label: 'Conocer Pabilo' },
};
const colors: Record<string, string> = { lime: '#d9f07c', cyan: '#8fe6ec', amber: '#f5bf7c', violet: '#c4adf4', coral: '#ff8c69' };
---

<a class="skip-link" href="#trayectoria">Saltar al contenido profesional</a>
<header class="masthead" data-header>
  <a class="wordmark" href="#inicio" aria-label="Andrus Díaz, inicio"><span class="monogram">a<span>↗</span>d</span><span>ANDRUS DÍAZ<small>MAKER / FOUNDER / SRE</small></span></a>
  <nav class="main-nav" aria-label="Navegación principal"><a href="#proyectos">Proyectos</a><a href="#trayectoria">Trayectoria</a></nav>
  <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" aria-label="Reducir movimiento"><span aria-hidden="true">Ⅱ</span><span class="motion-label">Pausar movimiento</span></button>
  <a class="header-contact" href={'mailto:' + email}><span class="desktop-email">{email}</span><span class="mobile-contact">Hablemos</span><span aria-hidden="true">↗</span></a>
</header>

<main id="contenido">
  <section class="cinema" id="inicio" aria-label="Del núcleo a un sistema vivo" data-cinema>
    <div class="cinema-stage" data-cinema-stage>
      <div class="cinema-visual" aria-hidden="true">
        <div class="world-glow"></div>
        <div class="world-fallback">
          <svg viewBox="0 0 1000 900" fill="none" role="presentation">
            <defs><linearGradient id="board-metal" x1="140" y1="200" x2="820" y2="750"><stop stop-color="#739e9c"/><stop offset=".45" stop-color="#1c343b"/><stop offset="1" stop-color="#0d1d25"/></linearGradient><linearGradient id="chip-metal"><stop stop-color="#e1cec0"/><stop offset=".5" stop-color="#647b80"/><stop offset="1" stop-color="#a9b6ad"/></linearGradient></defs>
            <g transform="translate(60 35) rotate(-18 500 460) skewX(12)">
              <rect x="180" y="295" width="590" height="365" rx="24" fill="#07131a" stroke="#3e6469" stroke-width="2"/>
              <rect x="180" y="270" width="590" height="365" rx="24" fill="url(#board-metal)" stroke="#91aaa3"/>
              <path d="M220 330h140v72h90m260-70h-96v72H550m-310 180h135v-80h74m270 80H620v-80h-70M285 295v50m36-50v50m360 200v52m-35-52v52" stroke="#caa377" stroke-width="3"/>
              <rect x="398" y="345" width="190" height="175" rx="13" fill="#102c35" stroke="#f3b47b" stroke-width="8"/>
              <rect x="416" y="326" width="154" height="157" rx="10" fill="url(#chip-metal)"/>
              <text x="493" y="414" text-anchor="middle" fill="#152d31" font-size="31" font-family="monospace">AD / 01</text>
              {[0,1,2,3,4,5].map((i) => <rect x={236 + i * 78} y="557" width="54" height="28" rx="3" fill="#0d222c" stroke="#638985"/>)}
              {[0,1,2,3].map((i) => <g><rect x="235" y={369 + i * 36} width="102" height="22" rx="3" fill="#132b35" stroke="#748c83"/><circle cx="248" cy={380 + i * 36} r="3" fill="#9bf5d1"/></g>)}
              <path d="M493 326V205h180V125m-180 80H270V100M673 125h90M270 100h-65" stroke="#8fe6ec" stroke-width="2" stroke-dasharray="8 7" opacity=".7"/>
              <circle cx="673" cy="125" r="10" fill="#f2b280"/><circle cx="270" cy="100" r="10" fill="#8fe6ec"/>
            </g>
          </svg>
        </div>
        <canvas id="systems-world" aria-label="Escultura de hardware y red distribuida; decoración opcional"></canvas>
        <div class="cinema-vignette"></div>
        <div class="world-coordinate coord-top">SYSTEM STUDY / AD—026</div>
        <div class="world-coordinate coord-side">BUILD → SHIP → OPERATE</div>
        <div class="world-caption"><span class="live-dot"></span><span data-scene-label>01 / EL ORIGEN</span><span>Una exploración de sistemas. No un dashboard en vivo.</span></div>
      </div>

      <div class="cinema-acts">
        <article class="cinema-act act-intro" data-act>
          <div class="act-copy page-shell">
            <p class="kicker"><span class="kicker-line"></span> VENEZUELA / REMOTO / INTERNET</p>
            <h1>Ideas que<br/>se vuelven<br/><em>sistemas vivos.</em></h1>
            <p class="hero-description">Soy <strong>Andrus Díaz.</strong> Construyo productos, les doy una plataforma y me quedo para operarlos.</p>
            <div class="hero-actions"><a class="action action-light" href="#proyectos">Explorar mi trabajo <span aria-hidden="true">↘</span></a><a class="email-link" href={'mailto:' + email}>{email} <span aria-hidden="true">↗</span></a></div>
            <p class="intro-signature">MAKER. FOUNDER. <span>SRE.</span></p>
          </div>
          <a class="scroll-invitation" href="#construir"><span aria-hidden="true">↓</span> EL RECORRIDO EMPIEZA CON UN SCROLL</a>
        </article>
        <article class="cinema-act" id="construir" data-act>
          <div class="act-copy page-shell"><p class="kicker">01 / MAKER</p><h2>Primero,<br/><em>hacerlo real.</em></h2><p class="act-description">Una idea no necesita otra presentación. Necesita su primera versión funcionando.</p><p class="act-detail">Diseño el producto. Escribo el backend. Conecto las piezas.</p><span class="chapter-note">DEL CONCEPTO AL PRIMER COMMIT</span></div>
        </article>
        <article class="cinema-act" id="entregar" data-act>
          <div class="act-copy page-shell"><p class="kicker">02 / FOUNDER</p><h2>Después,<br/><em>darle mundo.</em></h2><p class="act-description">Un núcleo se convierte en producto. Y los productos empiezan a formar un ecosistema.</p><p class="act-detail">Kaido, linko.store, Pabilo y Kroma: problemas reales, sistemas conectados.</p><span class="chapter-note">DEL PRIMER USUARIO A UNA PLATAFORMA</span></div>
        </article>
        <article class="cinema-act" id="operar" data-act>
          <div class="act-copy page-shell"><p class="kicker">03 / SRE</p><h2>Y cuando vive,<br/><em>estar ahí.</em></h2><p class="act-description">El deploy no es el final. Es donde empieza la responsabilidad.</p><p class="act-detail">Kubernetes, datos y observabilidad para entender qué pasa, responder y seguir construyendo.</p><a class="text-link" href="#trayectoria">Conocer mi recorrido <span aria-hidden="true">↗</span></a></div>
        </article>
      </div>
      <div class="cinema-progress" aria-hidden="true"><span>SCROLL TO BUILD</span><div><i data-cinema-progress></i></div><b data-chapter-index>01 / 04</b></div>
    </div>
  </section>

  <section class="work-section" id="proyectos">
    <div class="work-heading page-shell"><p class="kicker">EN EL CAMPO / PROYECTOS SELECCIONADOS</p><div><h2>No son demos.<br/><em>Son sistemas.</em></h2><p>Producto, plataforma y operación.<br/>Distintas piezas de una misma forma de trabajar.</p></div></div>
    <div class="projects-window" data-projects-window>
      <div class="projects-track" data-projects-track>
        {projects.map((project) => (
          <article class:list={['case-card', 'tone-' + project.accent]} style={{ '--case-color': colors[project.accent] }}>
            <div class="case-top"><span>PROYECTO / {project.id}</span><span>{project.eyebrow}</span></div>
            <div class="case-art" aria-hidden="true">
              <span class="case-watermark">{project.title === 'linko.store' ? 'linko' : project.title}</span>
              <div class="artifact-window"><div class="artifact-toolbar"><span></span><span></span><span></span><b>{project.title.toLowerCase()} / system</b></div>
                {project.title === 'Kaido' ? <div class="artifact-topology"><i>PRODUCTO</i><span>↓</span><div><b>IDENTIDAD</b><b>PAGOS</b><b>DATOS</b></div><span>↓</span><i class="artifact-foundation">PLATAFORMA / K3S</i></div>
                : project.title === 'linko.store' ? <div class="artifact-store"><div><span>Inventario</span><strong>Todo en su lugar.</strong></div><section>{[36,66,49,84,59,97,78].map((h)=><i style={{height:h+'%'}}></i>)}</section><footer>VENTAS / INVENTARIO / EQUIPOS <b>↗</b></footer></div>
                : project.title === 'Pabilo' ? <div class="artifact-payment"><span class="payment-check">✓</span><strong>Pago verificado.</strong><p>Una respuesta clara.<br/>Detrás, las integraciones correctas.</p><div>TRANSFERENCIA → API → CONFIRMACIÓN</div></div>
                : project.title === 'Kroma' ? <div class="artifact-identity"><span>◈</span><strong>Una identidad.<br/>Todo un ecosistema.</strong><div>SESIÓN <i>→</i> ACCESO <i>→</i> CONFIANZA</div></div>
                : <div class="artifact-trace"><span>TRACE / SERVICE MAP</span>{[62,83,46,73].map((w,i)=><div><b>0{i+1}</b><i style={{width:w+'%'}}></i></div>)}<footer>CONTEXTO ANTES QUE RUIDO.</footer></div>}
              </div>
              <span class="case-art-caption">INTERPRETACIÓN VISUAL DEL SISTEMA</span>
            </div>
            <div class="case-content"><h3>{project.title}</h3><p>{project.description}</p></div>
            <div class="case-bottom"><span>{project.stack}</span>{destinations[project.title] ? <a href={destinations[project.title].href} target="_blank" rel="noopener noreferrer">{destinations[project.title].label} <span aria-hidden="true">↗</span></a> : <a href={'mailto:' + email + '?subject=' + encodeURIComponent('Hablemos de ' + project.title)}>Hablemos del proyecto <span aria-hidden="true">↗</span></a>}</div>
          </article>
        ))}
      </div>
    </div>
    <div class="work-end page-shell"><span>CADA PRODUCTO ES UNA DECISIÓN LLEVADA A LA PRÁCTICA.</span><a href={'mailto:' + email}>¿Tienes algo entre manos? <b>Hablemos ↗</b></a></div>
  </section>

  <section id="trayectoria" class="experience-section">
    <div class="page-shell"><p class="kicker">TRAYECTORIA / LO QUE ME TRAJO HASTA AQUÍ</p><div class="experience-heading"><h2>Menos teoría.<br/><em>Más terreno.</em></h2><p>Producto, backend e infraestructura.<br/>La perspectiva cambia; la responsabilidad permanece.</p></div>
      <div class="experience-list">{experience.map((item,index)=><article class="experience-row"><div class="experience-time"><span>{item.period}</span><small>{item.location}</small></div><div class="experience-main"><p class="experience-role">{item.role}</p><h3>{item.company}</h3><p>{item.summary}</p><details><summary>Lo que construí y operé <span aria-hidden="true">+</span></summary><ul>{item.details.map(detail=><li>{detail}</li>)}</ul></details></div><span class="experience-index" aria-hidden="true">0{index+1}</span></article>)}</div>
    </div>
  </section>

  <section class="practice-section page-shell"><p class="kicker">LA CAJA DE HERRAMIENTAS</p><div class="practice-heading"><h2>Entender.<br/>Construir.<br/><em>Volver a mirar.</em></h2><p>Las herramientas importan.<br/>Saber por qué están ahí, más.</p></div><div class="tool-groups">{stackGroups.map(group=><article><h3>{group[0]}</h3><ul>{group.slice(1).map(tool=><li>{tool}</li>)}</ul></article>)}</div></section>

  <section class="contact-section" id="contacto"><div class="page-shell"><p class="kicker">ABRIR CANAL / SIN INTERMEDIARIOS</p><div class="contact-heading"><h2>La próxima idea<br/>puede empezar<br/><em>con un hola.</em></h2><span class="contact-arrow" aria-hidden="true">↗</span></div><p class="contact-description">¿Un producto por construir? ¿Una plataforma que necesita crecer? ¿Un sistema que dejó de ser claro? Hablemos de lo que tienes entre manos.</p><a class="contact-email" href={'mailto:' + email}>{email}<span aria-hidden="true">↗</span></a><div class="contact-options"><button type="button" data-copy-email data-email={email}>Copiar correo <span aria-hidden="true">⧉</span></button><span role="status" aria-live="polite" data-copy-status></span><a href="https://github.com/AndrusGerman/" target="_blank" rel="noopener noreferrer">GitHub / AndrusGerman ↗</a></div><div class="contact-meta"><span>ANDRUS DÍAZ / MAKER FOUNDER SRE</span><span>VENEZUELA · REMOTO · INTERNET</span></div></div></section>
</main>
<footer class="site-footer page-shell"><span>© {new Date().getFullYear()} ANDRUS DÍAZ</span><p>Construido con intención. Operado con cuidado.</p><a href="#inicio">Volver al origen ↑</a></footer>
<script>import '../scripts/cinematic-site';</script>

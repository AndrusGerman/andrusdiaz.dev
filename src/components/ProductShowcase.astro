---
import ProductPanel from './ProductPanel.astro';

const products = [
  {
    index: '01',
    name: 'Linko Store',
    tagline: 'Sistema integral de ventas',
    description:
      'Control total de tu operación comercial en una interfaz limpia e intuitiva. Inventario, ventas y reportes en tiempo real para que gestiones tu negocio sin fricción.',
    features: [
      'Control de inventario en tiempo real',
      'Punto de venta rápido y multi-sucursal',
      'Reportes de ventas y métricas de gestión',
    ],
    accent: 'linco',
  },
  {
    index: '02',
    name: 'Relay',
    tagline: 'Ventas automatizadas multicanal',
    description:
      'Plataforma multi-tenant que automatiza tus ventas y conecta todos tus canales. Flujos de mensajes dinámicos con WhatsApp como canal principal, integrado a tu CRM.',
    features: [
      'Automatización de ventas vía WhatsApp',
      'Arquitectura multi-tenant escalable',
      'Integración nativa con CRM y canales de mensajería',
    ],
    accent: 'relay',
  },
  {
    index: '03',
    name: 'Pabilo',
    tagline: 'Validación de pagos automatizada',
    description:
      'Seguridad y flujo de datos en cada transacción. Valida pagos automáticamente y vincula tu operación con Open Banking y ecosistemas de e-commerce como WooCommerce.',
    features: [
      'Validación automática de transacciones',
      'Conexión con entornos de Open Banking',
      'Integración con WooCommerce y e-commerce',
    ],
    accent: 'pabilo',
  },
  {
    index: '04',
    name: 'Linko Marketing',
    tagline: 'Marketing impulsado por IA',
    description:
      'Inteligencia Artificial aplicada al crecimiento de tu audiencia. Métricas en tiempo real, nodos de datos conectados y análisis algorítmico para decisiones más inteligentes.',
    features: [
      'Campañas optimizadas con Inteligencia Artificial',
      'Análisis algorítmico de audiencias',
      'Visualización de métricas de crecimiento en vivo',
    ],
    accent: 'marketing',
  },
] as const;
---

<section id="productos" class="relative" aria-label="Catálogo de productos">
  <!-- Encabezado de sección -->
  <div class="mx-auto max-w-4xl px-6 pb-8 pt-28 text-center" data-reveal>
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-accent-400">Soluciones propias</p>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      Tecnología desarrollada por <span class="text-accent-300">Kaido Group</span>
    </h2>
    <p class="mt-4 text-slate-400">
      Además de proyectos a medida, construimos nuestras propias plataformas. Desplázate para recorrerlas.
    </p>
  </div>

  <!-- Contenedor pinneado (se activa con JS; sin JS fluye en vertical) -->
  <div id="showcase-pin" class="relative">
    <!-- Escena 3D compartida: el objeto cambia según el producto activo -->
    <div class="pointer-events-none absolute inset-0 z-0 opacity-30 lg:opacity-100" aria-hidden="true">
      <canvas id="showcase-3d" class="h-full w-full"></canvas>
    </div>

    {products.map((p) => <ProductPanel {...p} />)}

    <!-- Indicador de progreso -->
    <div id="showcase-progress" class="absolute right-6 top-1/2 z-20 hidden -translate-y-1/2 flex-col gap-3" aria-hidden="true">
      {products.map((p, i) => (
        <span
          data-progress-dot={i}
          class="h-2.5 w-2.5 rounded-full bg-white/20 transition-all duration-300"
        ></span>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* Estado animado: GSAP fija la sección y apila los paneles */
  #showcase-pin.is-animated {
    height: 100vh;
    overflow: hidden;
  }
  #showcase-pin.is-animated .product-panel {
    position: absolute;
    inset: 0;
    padding: 0;
  }
  #showcase-pin.is-animated #showcase-progress {
    display: flex;
  }
</style>

---
const year = new Date().getFullYear();

const products = [
  { name: 'Linko Store', color: 'text-linco' },
  { name: 'Relay', color: 'text-relay' },
  { name: 'Pabilo', color: 'text-pabilo' },
  { name: 'Linko Marketing', color: 'text-marketing' },
];
---

<footer class="border-t border-white/10 py-12" aria-label="Pie de página">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-8 px-6 md:flex-row md:justify-between">
    <div class="flex items-center gap-3">
      <svg width="28" height="28" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="48" height="48" rx="12" fill="url(#footGrad)" />
        <path d="M16 13v22M16 24l12-11M18.5 26.5L32 35" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: rgb(var(--midnight))" />
        <defs>
          <linearGradient id="footGrad" x1="0" y1="0" x2="48" y2="48" gradientUnits="userSpaceOnUse">
            <stop style="stop-color: rgb(var(--accent-200))" />
            <stop offset="0.5" style="stop-color: rgb(var(--accent-500))" />
            <stop offset="1" style="stop-color: rgb(var(--accent-700))" />
          </linearGradient>
        </defs>
      </svg>
      <div>
        <p class="text-sm font-bold text-white">Kaido Group</p>
        <p class="text-xs text-slate-500">kaidogroup.tech</p>
      </div>
    </div>

    <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
      {products.map((p) => (
        <li><a href="#productos" class={`font-medium ${p.color} transition-opacity hover:opacity-75`}>{p.name}</a></li>
      ))}
    </ul>

    <p class="text-xs text-slate-500">© {year} Kaido Group. Todos los derechos reservados.</p>
  </div>
</footer>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    period: '2025 — 2026',
    company: 'InsightOne / Agnostiko',
    location: 'Remoto',
    role: 'SRE / Kubernetes',
    summary: 'Operación observable para productos que no pueden depender de la intuición.',
    details: [
      'GKE, Kustomize, Ingress, PostgreSQL / Cloud SQL, Redis y External Secrets.',
      'Métricas y spans HTTP/gRPC con OpenTelemetry; Grafana conectado a Cloud Monitoring y Logging.',
      'SLO, auditoría, alertas Telegram, health/readiness, Prometheus, KEDA y circuit breaker.',
    ],
    accent: 'cyan',
  },
  {
    period: '2026',
    company: 'Kaido',
    location: 'Ecosistema propio',
    role: 'Maker Founder SRE',
    summary: 'Un laboratorio de producto donde la infraestructura también es parte de la idea.',
    details: [
      'linko.store, Pabilo y Kroma conviven como productos con una base operable.',
      'k3s / Kubernetes, PostgreSQL con CloudNativePG, MongoDB, Grafana y Uptime Kuma.',
      'Cloudflare Tunnels, WireGuard, OpenTelemetry y GitHub Actions para entregar y observar.',
    ],
    accent: 'lime',
  },
  {
    period: '2024 — 2025',
    company: 'Proper Business Solutions',
    location: 'Panamá',
    role: 'Automatización / IA aplicada',
    summary: 'Convertir conversaciones operativas en decisiones que se puedan ejecutar.',
    details: [
      'Automatización de permisos por WhatsApp.',
      'Consultas asistidas por IA y clasificación de incidentes.',
    ],
    accent: 'amber',
  },
  {
    period: '2022 — 2024',
    company: 'Kuarere (Babel)',
    location: 'España',
    role: 'Kubernetes / Backend',
    summary: 'Migrar el terreno debajo de los microservicios sin detener el producto.',
    details: [
      'Kubernetes desde cero en VPS y migración desde Google App Engine.',
      'Ahorro verificado de hasta 85.98% en infraestructura.',
      'Despliegues de microservicios con Go, Angular, RabbitMQ y autenticación social.',
    ],
    accent: 'violet',
  },
  {
    period: '2018 — 2022',
    company: 'LinkoSoftware',
    location: 'Venezuela',
    role: 'Cloud / Producto',
    summary: 'Sistemas de logística y operación conectados a la realidad del negocio.',
    details: [
      'AWS con autoscaling y load balancing.',
      'Tracking de entregas, WebRTC, impresoras fiscales, tickets y cámaras.',
      'Intranet con servidores locales para mantener el trabajo en movimiento.',
    ],
    accent: 'coral',
  },
];

const projects = [
  {
    id: '01',
    eyebrow: 'ECOSISTEMA / OPERACIÓN',
    title: 'Kaido',
    description: 'La capa común detrás de productos que necesitan identidad, pagos, ventas y una operación que se pueda mirar de frente.',
    stack: 'k3s · PostgreSQL · MongoDB · Grafana',
    status: 'en construcción · 2026',
    accent: 'lime',
  },
  {
    id: '02',
    eyebrow: 'SAAS / MULTI-TENANT',
    title: 'linko.store',
    description: 'Ventas e inventario para equipos que necesitan una superficie simple y un backend preparado para crecer.',
    stack: 'Go · Angular · CloudNativePG',
    status: 'producto de Kaido',
    accent: 'cyan',
  },
  {
    id: '03',
    eyebrow: 'PAGOS / VENEZUELA',
    title: 'Pabilo',
    description: 'Verificación de pagos tipo Stripe para un contexto donde las transferencias y los métodos locales exigen otra lectura del sistema.',
    stack: 'MongoDB · APIs · integraciones',
    status: 'producto de Kaido',
    accent: 'amber',
  },
  {
    id: '04',
    eyebrow: 'IDENTIDAD / AUTH',
    title: 'Kroma',
    description: 'Identidad y autenticación como infraestructura compartida para los productos del ecosistema.',
    stack: 'sesiones · acceso · confianza',
    status: 'producto de Kaido',
    accent: 'violet',
  },
  {
    id: '05',
    eyebrow: 'OBSERVABILIDAD / GKE',
    title: 'Agnostiko',
    description: 'Telemetría que une React, Flutter y Android con servicios GKE: CPU, uptime, spans, logs, trazas y alertas que llegan cuando deben.',
    stack: 'OpenTelemetry · Grafana · KEDA',
    status: 'InsightOne · 2025—2026',
    accent: 'coral',
  },
];

const stackGroups = [
  ['ORQUESTACIÓN', 'Kubernetes', 'k3s', 'GKE', 'Kustomize', 'Ingress'],
  ['DATOS', 'PostgreSQL', 'CloudNativePG', 'Cloud SQL', 'MongoDB', 'Redis'],
  ['SEÑALES', 'OpenTelemetry', 'Prometheus', 'Grafana', 'Cloud Monitoring', 'Cloud Logging'],
  ['ENTREGA', 'GitHub Actions', 'Cloudflare Tunnels', 'WireGuard', 'KEDA', 'GCS / CDN'],
];
---

<BaseLayout
  title="Andrus Díaz — Maker Founder SRE"
  description="Andrus Díaz construye y opera productos, plataformas e infraestructura observable: Kaido, linko.store, Pabilo, Kroma e InsightOne."
>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <header class="topbar" data-header>
    <a class="brand" href="#inicio" aria-label="Andrus Díaz, inicio">
      <span class="brand-mark" aria-hidden="true">AD</span>
      <span class="brand-copy"><b>ANDRUS</b><b>DÍAZ</b></span>
    </a>
    <p class="topbar-state"><span class="status-dot"></span> construyendo sistemas reales</p>
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="#trayectoria">Trayectoria</a>
      <a href="#proyectos">Sistemas</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <a class="topbar-cta" href="mailto:contacto@andrusdiaz.dev">Hablemos <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <span></span><span></span>
    </button>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Navegación móvil" hidden data-mobile-nav>
      <a href="#trayectoria">Trayectoria</a>
      <a href="#proyectos">Sistemas</a>
      <a href="#contacto">Contacto</a>
      <a href="mailto:contacto@andrusdiaz.dev">contacto@andrusdiaz.dev</a>
    </nav>
  </header>

  <main id="contenido">
    <section id="inicio" class="hero section-shell">
      <div class="hero-gridline" aria-hidden="true"></div>
      <div class="hero-copy" data-reveal>
        <div class="eyebrow"><span>01</span> MAKER FOUNDER SRE <i>·</i> VENEZUELA / INTERNET</div>
        <h1>Construyo sistemas<br /><em>que resisten.</em></h1>
        <p class="hero-intro">Soy Andrus Díaz. Paso de una idea a un producto, de un producto a una plataforma y de una plataforma a señales que se pueden leer cuando algo cambia.</p>
        <div class="hero-actions">
          <a class="button button-primary" data-magnetic href="#proyectos">Explorar sistemas <span aria-hidden="true">↓</span></a>
          <a class="quiet-link" href="mailto:contacto@andrusdiaz.dev">contacto@andrusdiaz.dev <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="hero-stage" data-reveal aria-label="Panel visual de telemetría de Andrus Díaz">
        <canvas id="hero-3d" aria-hidden="true"></canvas>
        <div class="scene-fallback" aria-hidden="true">
          <div class="fallback-orbit orbit-a"></div><div class="fallback-orbit orbit-b"></div>
          <div class="fallback-core"><span>AD</span><small>LIVE SYSTEM</small></div>
          <i class="fallback-node node-a"></i><i class="fallback-node node-b"></i><i class="fallback-node node-c"></i>
        </div>
        <div class="stage-topline"><span>FIELD NOTE 026</span><span>LIVE / 3D SIGNAL</span></div>
        <div class="stage-readout readout-a"><small>CLUSTER</small><strong>KAIDO / K3S</strong><span class="pulse-line"></span></div>
        <div class="stage-readout readout-b"><small>TRACE HEALTH</small><strong>99.98%</strong><span>OTLP · gRPC</span></div>
        <div class="stage-axis axis-x">X / 03</div><div class="stage-axis axis-y">Y / 26</div>
        <div class="stage-footer"><span><i class="status-dot"></i> señales nominales</span><span>lat 00:04:28</span></div>
      </div>

      <div class="hero-index" data-reveal>
        <span>andrusdiaz.dev / control room</span>
        <span>productos · infraestructura · observabilidad</span>
        <a href="#trayectoria">ver recorrido <b aria-hidden="true">↘</b></a>
      </div>
    </section>

    <div class="signal-band" aria-label="Tecnologías y áreas de trabajo">
      <div class="signal-track">
        <span>GO <i>✳</i> KUBERNETES <i>✳</i> OBSERVABILIDAD <i>✳</i> POSTGRESQL <i>✳</i> PRODUCTO DIGITAL <i>✳</i> OPEN TELEMETRY <i>✳</i></span>
        <span aria-hidden="true">GO <i>✳</i> KUBERNETES <i>✳</i> OBSERVABILIDAD <i>✳</i> POSTGRESQL <i>✳</i> PRODUCTO DIGITAL <i>✳</i> OPEN TELEMETRY <i>✳</i></span>
      </div>
    </div>

    <section id="sistemas" class="manifesto section-shell section-space">
      <div class="section-label" data-reveal><span>02</span> FORMA DE OPERAR</div>
      <div class="manifesto-grid">
        <h2 data-reveal>El sistema<br />también cuenta<br /><em>su historia.</em></h2>
        <div class="manifesto-copy" data-reveal>
          <p>Construir no termina cuando el deploy pasa. Me interesa que las decisiones queden visibles: qué se movió, qué está vivo, qué puede fallar y quién puede arreglarlo.</p>
          <p>Por eso mi trabajo cruza backend, Kubernetes, producto y observabilidad. Una buena interfaz muestra una intención; una buena plataforma la sostiene.</p>
          <a class="quiet-link dark" href="#proyectos">Ver el mapa de sistemas <span aria-hidden="true">↘</span></a>
        </div>
      </div>
      <div class="principles" data-reveal>
        <article><span>01 / SIGNAL</span><h3>Hacer visible lo importante.</h3><p>Señales útiles antes que ruido: métricas, logs, spans y contexto.</p></article>
        <article><span>02 / SHIP</span><h3>Entregar con ritmo.</h3><p>Automatización y despliegues repetibles para que el equipo avance.</p></article>
        <article><span>03 / CARE</span><h3>Diseñar para el siguiente incidente.</h3><p>Health checks, límites y documentación para volver a confiar.</p></article>
      </div>
    </section>

    <section id="trayectoria" class="timeline-section">
      <div class="section-shell">
        <div class="section-label section-label-light" data-reveal><span>03</span> TRAYECTORIA / BUILD LOG</div>
        <div class="timeline-heading" data-reveal>
          <h2>De la mesa<br />al <em>cluster.</em></h2>
          <p>Un recorrido entre producto, operación y sistemas que tienen que seguir respondiendo cuando la pantalla se queda en silencio.</p>
        </div>
        <div class="timeline" data-reveal>
          {experience.map((item, index) => (
            <article class={`timeline-item accent-${item.accent}`}>
              <div class="timeline-marker"><span>{String(index + 1).padStart(2, '0')}</span><i></i></div>
              <div class="timeline-meta"><span>{item.period}</span><span>{item.location}</span></div>
              <div class="timeline-main">
                <div class="timeline-title"><h3>{item.company}</h3><span>{item.role}</span></div>
                <p class="timeline-summary">{item.summary}</p>
                <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>
              </div>
              <span class="timeline-signal" aria-hidden="true">0{index + 1} / OK</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="proyectos" class="systems-section section-shell section-space">
      <div class="section-label" data-reveal><span>04</span> SISTEMAS EN EL CAMPO</div>
      <div class="systems-heading" data-reveal>
        <h2>Productos con<br /><em>señal.</em></h2>
        <p>Una selección del ecosistema y de las plataformas donde la idea se convierte en una operación completa.</p>
      </div>
      <div class="systems-grid">
        {projects.map((project) => (
          <article class={`system-card card-${project.accent}`} data-reveal data-tilt>
            <div class="system-card-top"><span>{project.id}</span><span>{project.eyebrow}</span></div>
            <div class="system-graphic" aria-hidden="true"><span class="graphic-ring ring-1"></span><span class="graphic-ring ring-2"></span><span class="graphic-node"></span><span class="graphic-line"></span></div>
            <div class="system-card-body"><h3>{project.title}</h3><p>{project.description}</p></div>
            <div class="system-card-foot"><span>{project.stack}</span><span>{project.status}</span></div>
          </article>
        ))}
      </div>
    </section>

    <section class="stack-section section-shell section-space">
      <div class="section-label" data-reveal><span>05</span> INSTRUMENTOS</div>
      <div class="stack-grid">
        {stackGroups.map((group) => (
          <article data-reveal>
            <h3>{group[0]}</h3>
            <ul>{group.slice(1).map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
      <div class="stack-note" data-reveal><span class="status-dot"></span><p>La herramienta cambia. La responsabilidad de entender el sistema permanece.</p></div>
    </section>

    <section id="contacto" class="contact-section">
      <div class="contact-shell section-shell" data-reveal>
        <div class="section-label section-label-light"><span>06</span> ABRIR CANAL</div>
        <div class="contact-grid">
          <h2>¿Qué vamos<br />a <em>construir?</em></h2>
          <div class="contact-copy"><p>Si estás resolviendo un problema difícil de producto, plataforma u operación, escríbeme. Puedo ayudarte a encontrar la forma que el sistema necesita.</p><a class="button button-primary" data-magnetic href="mailto:contacto@andrusdiaz.dev">contacto@andrusdiaz.dev <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="contact-foot"><span>ANDRUS DÍAZ / MAKER FOUNDER SRE</span><span>VENEZUELA · REMOTO · INTERNET</span><a href="https://github.com/AndrusGerman/" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
      </div>
    </section>
  </main>

  <footer class="site-footer section-shell">
    <a class="brand" href="#inicio" aria-label="Volver al inicio"><span class="brand-mark" aria-hidden="true">AD</span><span class="brand-copy"><b>ANDRUS</b><b>DÍAZ</b></span></a>
    <p>Productos, plataformas y señales que ayudan a operar.</p>
    <span>© {new Date().getFullYear()}</span>
  </footer>

  <script>import '../scripts/site';</script>
</BaseLayout>
